name: بناء مُثبِّت ويندوز

# التشغيل يدوي فقط. البناء يستغرق ~40 دقيقة ويُحسب بمعامل ×2 على
# دقائق ويندوز، فتشغيله عند كل دفعة إهدار. والأهم أن النسخة السابقة
# كانت تعمل على push فتُنتج مُثبِّتات لا يطلبها أحد.
on:
  workflow_dispatch:
    inputs:
      full_tests:
        description: "الفحص الشامل (48 ملفًا) بدل الحزمة الحرجة"
        type: boolean
        default: false
      include_owner:
        description: "بناء برنامج المالك أيضًا (سرّي)"
        type: boolean
        default: true

env:
  USER_APP_ID: "AhmedAlFaifiMarketImageStudio"
  OWNER_APP_ID: "AhmedAlFaifiOwnerStudio"
  PYTHONUTF8: "1"

jobs:
  build:
    runs-on: windows-latest
    timeout-minutes: 120

    steps:
      - name: استنساخ المستودع
        uses: actions/checkout@v4

      # الإصدار مصدره الوحيد ملف VERSION. كان مثبّتًا نصيًا هنا
      # (2.9.5) فتخلّف عن التطبيق (2.9.9) وصارت الورشة تتحقق من
      # وجود ملف بإصدار لا يُنتجه المُثبِّت ⇒ تفشل برسالة مضلّلة
      # «مُثبِّت المستخدم مفقود».
      - name: قراءة الإصدار من ملف VERSION
        shell: pwsh
        run: |
          $v = (Get-Content VERSION -Raw).Trim()
          if ($v -notmatch '^\d+\.\d+\.\d+$') {
            throw "صيغة VERSION غير صالحة: '$v'"
          }
          "APP_VERSION=$v" | Out-File $env:GITHUB_ENV -Append -Encoding utf8
          "الإصدار المقروء: $v"


      # 3.11 لا 3.12: هو ما اختُبر عليه المشروع (48/48 ملفًا)، ولا
      # داعي لإدخال متغيّر جديد في بناء الإصدار.
      - name: تهيئة بايثون 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      # بيانات إصدار PyInstaller تُولَّد من VERSION: كانت تُكتب
      # يدويًا فتخلّف نسخة المالك على 2.9.5 بينما التطبيق 2.9.9.
      - name: توليد بيانات الإصدار
        shell: pwsh
        run: python build/windows/توليد_بيانات_الإصدار.py

      # التبعيات من requirements.txt مصدرًا وحيدًا. القائمة اليدوية
      # الموازية في النسخة السابقة أسقطت xlrd (قراءة .xls) و qrcode
      # و segno (مصادقة المالك الثنائية)، وأدخلت arabic-reshaper
      # و python-bidi وهما غير مستخدمتين في الكود إطلاقًا.
      - name: تركيب التبعيات
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pyinstaller==6.11.1
          pip install zxing-cpp
          if ($LASTEXITCODE -ne 0) {
            Write-Host "::warning::zxing-cpp لم تُركّب — قراءة الباركود تعود لـ opencv"
          }
          $global:LASTEXITCODE = 0

      # النماذج مستبعدة من git لحجمها (183 م.ب). التحقق بالبصمة لا
      # بالحجم: النسخة السابقة كانت تفحص الحجم فقط، وملف مقطوع أو
      # مبدَّل قد يوافق الحجم ثم يُنفَّذ داخل onnxruntime.
      - name: تجهيز نماذج القص والتحقق من بصماتها
        shell: pwsh
        run: python tools/fetch_models.py

      # ------------------------------------------------------ سرّ المالك
      # owner_secrets.json لا يُرفع للمستودع أبدًا. يُخزَّن كـ Secret
      # باسم OWNER_SECRETS_JSON (محتوى الملف كما هو). غيابه لا يمنع
      # البناء لكنه يعني انفصال المفاتيح المُصدَرة سابقًا.
      - name: استعادة شفرة المالك من Secret
        shell: pwsh
        env:
          OWNER_SECRETS_JSON: ${{ secrets.OWNER_SECRETS_JSON }}
        run: |
          if ([string]::IsNullOrWhiteSpace($env:OWNER_SECRETS_JSON)) {
            Write-Host "::warning::لا OWNER_SECRETS_JSON — تخطّي التحقق من الربط"
          } else {
            $dir = "owner_studio/بيانات_المالك"
            New-Item -ItemType Directory -Force -Path $dir | Out-Null
            [System.IO.File]::WriteAllText(
              "$dir/owner_secrets.json", $env:OWNER_SECRETS_JSON,
              (New-Object System.Text.UTF8Encoding $false))
            Write-Host "استُعيدت شفرة المالك"
          }

      - name: التحقق من ربط المالك بالمستخدم
        shell: pwsh
        run: |
          if (Test-Path "owner_studio/بيانات_المالك/owner_secrets.json") {
            python tools/verify_owner_link.py
            if ($LASTEXITCODE -ne 0) { throw "الربط مكسور — أوقف البناء" }
          } else {
            Write-Host "::warning::تخطّي (لا شفرة مالك في بيئة البناء)"
          }

      # يرصد ملفات البيانات الناقصة ووحدات الوعي غير المكتشفة قبل
      # إهدار ~20 دقيقة في PyInstaller ثم الفشل برسالة غامضة.
      - name: فحص مسبق لملف المواصفات
        shell: pwsh
        run: |
          python tools/verify_spec_discovery.py
          if ($LASTEXITCODE -ne 0) { throw "الفحص المسبق فشل" }

      - name: الاختبارات (الحزمة الحرجة)
        if: ${{ inputs.full_tests == false }}
        shell: pwsh
        run: |
          $env:PYTHONPATH = "src;windows_app;owner_studio;."
          $env:QT_QPA_PLATFORM = "offscreen"
          $failed = @()
          foreach ($t in @("test_license.py", "test_trial_and_link.py",
                           "test_units.py", "test_owner_data_dir.py",
                           "test_env_resilience.py", "test_surgeon_gates.py")) {
            if (-not (Test-Path "tests/$t")) { continue }
            Write-Host "----- $t"
            python "tests/$t"
            if ($LASTEXITCODE -ne 0) { $failed += $t }
          }
          if ($failed.Count -gt 0) { throw "فاشل: $($failed -join ', ')" }

      - name: الاختبارات (الفحص الشامل)
        if: ${{ inputs.full_tests == true }}
        shell: pwsh
        run: |
          $env:PYTHONPATH = "src;windows_app;owner_studio;."
          $env:QT_QPA_PLATFORM = "offscreen"
          python tools/run_all_tests.py
          if ($LASTEXITCODE -ne 0) { throw "الفحص الشامل فشل" }

      # -------------------------------------------------------- التحزيم
      - name: بناء برنامج المستخدم
        shell: pwsh
        run: |
          pyinstaller --noconfirm --distpath dist/windows --workpath build_tmp `
            build/windows/AhmedAlFaifiMarketImageStudioV2.spec
          $exe = "dist/windows/$env:USER_APP_ID/$env:USER_APP_ID.exe"
          if (-not (Test-Path $exe)) { throw "تنفيذي المستخدم مفقود" }
          "حجم التنفيذي: {0:N1} م.ب" -f ((Get-Item $exe).Length / 1MB)

      - name: بناء برنامج المالك
        if: ${{ inputs.include_owner == true }}
        shell: pwsh
        run: |
          pyinstaller --noconfirm --distpath dist/windows --workpath build_tmp_owner `
            build/windows/AhmedAlFaifiOwnerStudio.spec
          $exe = "dist/windows/$env:OWNER_APP_ID/$env:OWNER_APP_ID.exe"
          if (-not (Test-Path $exe)) { throw "تنفيذي المالك مفقود" }

      # Tesseract محمول: بلا تثبيت منفصل على جهاز المستخدم. غيابه لا
      # يُفشل البناء لأن قراءة النصوص تتراجع بلطف.
      - name: إضافة Tesseract محمول (عربي + إنجليزي)
        shell: pwsh
        continue-on-error: true
        run: |
          $dest = "dist/windows/$env:USER_APP_ID/tesseract"
          New-Item -ItemType Directory -Force -Path $dest | Out-Null
          $url = "https://github.com/UB-Mannheim/tesseract/releases/download/v5.4.0.20240606/tesseract-ocr-w64-setup-5.4.0.20240606.exe"
          Invoke-WebRequest -Uri $url -OutFile tesseract-setup.exe
          7z x tesseract-setup.exe -o"tess_extract" -y | Out-Null
          Copy-Item tess_extract/* $dest -Recurse -Force
          $td = Join-Path $dest "tessdata"
          New-Item -ItemType Directory -Force -Path $td | Out-Null
          foreach ($lang in @("ara", "eng")) {
            Invoke-WebRequest -Uri "https://github.com/tesseract-ocr/tessdata_fast/raw/main/$lang.traineddata" `
              -OutFile (Join-Path $td "$lang.traineddata")
          }
          if (-not (Test-Path (Join-Path $dest "tesseract.exe"))) {
            Write-Host "::warning::tesseract.exe غير موجود — OCR يتراجع بلطف"
          }

      # الاختبارات تفحص الوحدات؛ هذا يفحص الحزمة المجمّدة نفسها،
      # وهو الموضع الوحيد الذي تظهر فيه أعطال الاستيراد المفقود.
      - name: فحص تشغيل برنامج المستخدم
        shell: pwsh
        run: |
          $exe = "dist/windows/$env:USER_APP_ID/$env:USER_APP_ID.exe"
          $p = Start-Process -FilePath $exe -PassThru
          Start-Sleep -Seconds 30
          if ($p.HasExited) { throw "انهار مبكرًا برمز $($p.ExitCode)" }
          Stop-Process -Id $p.Id -Force
          Write-Host "صمد 30 ثانية — سليم"

      - name: فحص تشغيل برنامج المالك
        if: ${{ inputs.include_owner == true }}
        shell: pwsh
        run: |
          $exe = "dist/windows/$env:OWNER_APP_ID/$env:OWNER_APP_ID.exe"
          $p = Start-Process -FilePath $exe -PassThru
          Start-Sleep -Seconds 25
          if ($p.HasExited) { throw "انهار مبكرًا برمز $($p.ExitCode)" }
          Stop-Process -Id $p.Id -Force
          Write-Host "صمد 25 ثانية — سليم"

      # ------------------------------------------------------ المُثبِّتات
      - name: تركيب NSIS
        shell: pwsh
        run: choco install nsis -y --no-progress

      - name: بناء مُثبِّت المستخدم
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force -Path dist/installer | Out-Null
          & "C:\Program Files (x86)\NSIS\makensis.exe" build\windows\installer.nsi
          $f = "dist/installer/$env:USER_APP_ID-Setup-$env:APP_VERSION.exe"
          if (-not (Test-Path $f)) { throw "مُثبِّت المستخدم مفقود" }
          $item = Get-Item $f
          "المُثبِّت: {0} — {1:N1} م.ب" -f $item.Name, ($item.Length / 1MB)
          (Get-FileHash $f -Algorithm SHA256).Hash |
            Tee-Object -FilePath dist/installer/user-setup.sha256

      - name: بناء مُثبِّت المالك
        if: ${{ inputs.include_owner == true }}
        shell: pwsh
        run: |
          & "C:\Program Files (x86)\NSIS\makensis.exe" build\windows\installer_owner.nsi
          $f = "dist/installer/$env:OWNER_APP_ID-Setup-$env:APP_VERSION.exe"
          if (-not (Test-Path $f)) { throw "مُثبِّت المالك مفقود" }
          (Get-FileHash $f -Algorithm SHA256).Hash |
            Tee-Object -FilePath dist/installer/owner-setup.sha256

      # -------------------------------------------------------- المخرجات
      # compression-level: 0 لأن الـ exe مضغوط أصلًا؛ إعادة ضغطه
      # تستهلك دقائق بلا ربح يُذكر.
      - name: رفع مُثبِّت المستخدم
        uses: actions/upload-artifact@v4
        with:
          name: Setup-User-${{ env.APP_VERSION }}
          path: |
            dist/installer/${{ env.USER_APP_ID }}-Setup-${{ env.APP_VERSION }}.exe
            dist/installer/user-setup.sha256
          retention-days: 90
          compression-level: 0

      - name: رفع مُثبِّت المالك (سرّي)
        if: ${{ inputs.include_owner == true }}
        uses: actions/upload-artifact@v4
        with:
          name: Setup-Owner-${{ env.APP_VERSION }}-CONFIDENTIAL
          path: |
            dist/installer/${{ env.OWNER_APP_ID }}-Setup-${{ env.APP_VERSION }}.exe
            dist/installer/owner-setup.sha256
          retention-days: 90
          compression-level: 0

      # يُرفع عند الفشل فقط: هو الدليل الوحيد على السبب.
      - name: رفع سجلات البناء عند الفشل
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: build-logs
          path: |
            build_tmp/**/*.txt
            build_tmp_owner/**/*.txt
          retention-days: 14
          if-no-files-found: ignore
